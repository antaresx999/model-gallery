# Konfiguration der Model Gallery (/etc/model-gallery.env)
GALLERY_HOST=0.0.0.0
GALLERY_PORT=8080
GALLERY_DATA=/var/lib/model-gallery
GALLERY_SITE_NAME=Studio Galerie
# Öffentliche Adresse – wird für die Permalinks verwendet
GALLERY_BASE_URL=
# Auf 1 setzen, sobald die Seite über HTTPS (Reverse Proxy) läuft
GALLERY_COOKIE_SECURE=0
GALLERY_ADMIN_USER=admin
# Leer lassen: Beim ersten Start wird ein Passwort erzeugt und in $GALLERY_DATA/initial-admin-password.txt abgelegt
GALLERY_ADMIN_PASSWORD=
# Bildgrössen (lange Kante in Pixel)
GALLERY_THUMB_SIZE=640
GALLERY_PREVIEW_SIZE=2048
# E-Mail-Benachrichtigungen (optional)
# GALLERY_SMTP_HOST=smtp.example.ch
# GALLERY_SMTP_PORT=587
# GALLERY_SMTP_USER=
# GALLERY_SMTP_PASSWORD=
# GALLERY_SMTP_FROM=galerie@example.ch
# GALLERY_SMTP_TLS=starttls
